cabal-version:      3.0
name:               Automata
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Matias Dominguez
maintainer:         matias.dominguez@cosmesoft.com.py
category:           Language
build-type:         Simple
common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Automata,
                      Automata.Core,
                      Automata.Elements.FiniteAutomata
    build-depends:    base ^>=4.20.2.0,
                      containers
    hs-source-dirs:   src
    default-language: GHC2024

test-suite automata-tests
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:    FiniteAutomataSpec
    build-depends:    base ^>= 4.20.2.0,
                      containers,
                      HUnit,
                      Automata
    default-language: GHC2024
        
